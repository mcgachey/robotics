#!/usr/bin/env bash
# Fetch the pinned astromech_server source and build the controller UI into .deps-cache/controller.
# Config time only (git clone, npm ci). Called by `make build`.
set -euo pipefail
cd "$(dirname "$0")/.."
# shellcheck source=/dev/null
. deps/astromech.env
CACHE=.deps-cache
SRC=$CACHE/astromech_server
OUT=$CACHE/controller

case "$ASTROMECH_REF" in
  REPLACE_*|"") echo "WARNING: ASTROMECH_REF not set in deps/astromech.env; board controller not built"; rm -rf "$OUT"; exit 0;;
esac

if [ "$(git -C "$SRC" rev-parse HEAD 2>/dev/null || true)" != "$ASTROMECH_REF" ]; then
  rm -rf "$SRC"; mkdir -p "$SRC"
  git -C "$SRC" init -q
  git -C "$SRC" fetch -q --depth 1 "$ASTROMECH_REPO" "$ASTROMECH_REF"
  git -C "$SRC" checkout -q FETCH_HEAD
  [ "$(git -C "$SRC" rev-parse HEAD)" = "$ASTROMECH_REF" ] || { echo "ERROR: fetched ref is not $ASTROMECH_REF (use a full SHA)" >&2; exit 1; }
fi
for d in raspberrypi_controller/src raspberrypi_controller/ui esp32/sdk/python; do
  [ -d "$SRC/$d" ] || { echo "ERROR: $d missing at $ASTROMECH_REF" >&2; exit 1; }
done

UI=$SRC/raspberrypi_controller/ui
( cd "$UI" && npm ci --no-audit --no-fund && npm run build )

rm -rf "$OUT"; mkdir -p "$OUT"
cp -a "$SRC/raspberrypi_controller/src" "$OUT/src"
rm -rf "$OUT/src/static" "$OUT/src/__pycache__"
cp -a "$UI/dist" "$OUT/src/static"
cp -a "$SRC/esp32/sdk/python" "$OUT/sdk"
cp "$SRC/raspberrypi_controller/requirements.txt" "$OUT/requirements.txt"
cp "$SRC/config/droids.yml" "$OUT/droids.example.yml" 2>/dev/null || true
echo "controller built from $ASTROMECH_REF"
